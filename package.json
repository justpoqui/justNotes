{
  "name": "justnotes",
  "version": "1.0.0",
  "description": "A local-first notebook: plain Markdown files, notebooks, sections, pages and whiteboards. Fully offline.",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/copy-excalidraw-fonts.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/copy-excalidraw-fonts.mjs",
    "build": "electron-vite build",
    "prestart": "npm run build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --exclude \"tests/stress/**\"",
    "test:stress": "vitest run tests/stress --testTimeout=300000",
    "package": "npm run build && electron-builder --linux AppImage deb --publish never"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-collaboration": "^3.32.2",
    "@tiptap/extension-drag-handle": "^3.32.2",
    "@tiptap/extension-drag-handle-react": "^3.32.2",
    "@tiptap/extension-heading": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-node-range": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "@tiptap/y-tiptap": "^3.0.12",
    "@types/node": "^22.20.5",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "lowlight": "^3.3.0",
    "nspell": "^2.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "katex": "^0.19.1",
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.20",
      "@radix-ui/react-tabs": "^1.1.13"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.5"
    },
    "@electron/universal": {
      "minimatch": "^11.0.5"
    }
  },
  "productName": "justNotes",
  "author": "justpoqui",
  "homepage": "https://github.com/justpoqui/justNotes",
  "build": {
    "appId": "app.justnotes.desktop",
    "productName": "justNotes",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "executableName": "justnotes",
      "synopsis": "Local-first notebook with Markdown pages and whiteboards",
      "maintainer": "justpoqui",
      "desktop": {
        "entry": {
          "StartupWMClass": "justNotes"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "justnotes",
      "artifactName": "justnotes_${version}_${arch}.deb"
    },
    "appImage": {
      "artifactName": "justNotes-${arch}.AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "justpoqui",
      "repo": "justNotes",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "justNotes"
    },
    "nsis": {
      "artifactName": "justNotes-Setup-${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "justNotes",
      "deleteAppDataOnUninstall": false
    }
  },
  "desktopName": "justnotes.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/justpoqui/justNotes.git"
  }
}
