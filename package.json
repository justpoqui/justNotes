{
  "name": "justnotes",
  "version": "0.1.0",
  "description": "Local-first notebook app: Markdown files on disk, Notebook → Section → Page.",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/copy-excalidraw-fonts.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/copy-excalidraw-fonts.mjs",
    "build": "electron-vite build",
    "prestart": "npm run build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --exclude \"tests/stress/**\"",
    "test:stress": "vitest run tests/stress --testTimeout=300000"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-collaboration": "^3.32.2",
    "@tiptap/extension-drag-handle": "^3.32.2",
    "@tiptap/extension-drag-handle-react": "^3.32.2",
    "@tiptap/extension-heading": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-node-range": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "@tiptap/y-tiptap": "^3.0.12",
    "dictionary-en": "^4.0.0",
    "lowlight": "^3.3.0",
    "nspell": "^2.1.5"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "katex": "^0.19.1",
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.20",
      "@radix-ui/react-tabs": "^1.1.13"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    }
  }
}
